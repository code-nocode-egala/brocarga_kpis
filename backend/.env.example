# Copy to `backend/.env` and adjust. Real environment variables always win over
# this file, so a deployed container's injected secrets are never shadowed.

# -- Django ---------------------------------------------------------------
DJANGO_DEBUG=true
# Required whenever DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Amsterdam
LOG_LEVEL=INFO

# -- Data source ----------------------------------------------------------
# "sample" = deterministic in-process dataset (no credentials, no network).
# "bubble" = the real Bubble app; then BASE_URL and API_TOKEN are both required.
BUBBLE_PROVIDER=sample
BUBBLE_BASE_URL=
BUBBLE_API_TOKEN=
